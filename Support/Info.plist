<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key><string>en</string>
    <key>CFBundleLocalizations</key>
    <array><string>en</string><string>pl</string></array>
    <key>CFBundleExecutable</key><string>MacLister</string>
    <key>CFBundleIconFile</key><string>AppIcon</string>
    <key>CFBundleIdentifier</key><string>com.example.MacLister</string>
    <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
    <key>CFBundleName</key><string>MacLister</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>1.7.10</string>
    <key>CFBundleVersion</key><string>28</string>
    <key>MacListerReleaseDate</key><string>2026-11-27</string>
    <key>NSHumanReadableCopyright</key><string>© 2026 Grzegorz Murdzek. MIT License.</string>
    <key>MacListerUpdateFeed</key>
    <string>https://api.github.com/repos/grzegorzmurdzek/MacLister/releases</string>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key><string>MacLister folder</string>
            <key>CFBundleURLSchemes</key>
            <array><string>maclister</string></array>
        </dict>
    </array>
    <!-- Finder: right-click a folder → Open With → MacLister, and drop folders on the Dock icon -->
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key><string>Folder</string>
            <key>CFBundleTypeRole</key><string>Viewer</string>
            <key>LSHandlerRank</key><string>Alternate</string>
            <key>LSItemContentTypes</key>
            <array><string>public.folder</string></array>
        </dict>
    </array>
    <!-- Finder: right-click → Services → Open in MacLister (a key can be given in System Settings → Keyboard → Keyboard Shortcuts → Services) -->
    <key>NSServices</key>
    <array>
        <dict>
            <key>NSMenuItem</key>
            <dict><key>default</key><string>Open in MacLister</string></dict>
            <key>NSMessage</key><string>openInMacLister</string>
            <key>NSPortName</key><string>MacLister</string>
            <key>NSSendFileTypes</key>
            <array><string>public.item</string></array>
        </dict>
    </array>
    <key>LSMinimumSystemVersion</key><string>13.0</string>
    <key>LSUIElement</key><true/>
    <key>NSHighResolutionCapable</key><true/>
    <key>NSLocalNetworkUsageDescription</key>
    <string>MacLister looks for computers that share files on your network (Go → Shared).</string>
    <key>NSBonjourServices</key>
    <array>
        <string>_smb._tcp</string>
        <string>_afpovertcp._tcp</string>
        <string>_sftp-ssh._tcp</string>
        <string>_ftp._tcp</string>
    </array>
    <key>NSDesktopFolderUsageDescription</key>
    <string>MacLister shows the contents of folders you browse.</string>
    <key>NSDocumentsFolderUsageDescription</key>
    <string>MacLister shows the contents of folders you browse.</string>
    <key>NSDownloadsFolderUsageDescription</key>
    <string>MacLister shows the contents of folders you browse.</string>
    <key>NSRemovableVolumesUsageDescription</key>
    <string>MacLister shows the contents of folders you browse.</string>
    <key>NSNetworkVolumesUsageDescription</key>
    <string>MacLister shows the contents of folders you browse.</string>
</dict>
</plist>
